# PostgreSQL Database Connections (Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ikikelam?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/ikikelam?schema=public"

# Supabase Storage & Services
SUPABASE_URL="https://your-project.supabase.co"
# Server-side only (Secret - never expose to client!)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="gallery"

# Authentication Secret (Server-side only)
AUTH_SECRET="your-super-secret-jwt-key-minimum-32-chars"

# Initial Admin Seed Credentials (Used by seed script only)
SEED_ADMIN_EMAIL="admin@ikikelam.org.tr"
SEED_ADMIN_PASSWORD="change-me-strong-password-123"

# Public Environment Variables (Accessible on Client & Server)
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
NUXT_PUBLIC_WHATSAPP_NUMBER="+905411557401"
NUXT_PUBLIC_GOOGLE_MAPS_URL="https://www.google.com/maps/place//data=!4m2!3m1!1s0x14b9659d91b2e59f:0x46bb50e2b956af15?sa=X&ved=1t:8290&ictx=111"
